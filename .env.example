# ==============================================================================
# Lacak Buzzer Environment Configuration Template
# Salin berkas ini menjadi .env sebelum menjalankan aplikasi / docker compose
# ==============================================================================

# OpenRouter API Key (digunakan untuk menghasilkan narasi penjelasan AI dalam Bahasa Indonesia)
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=openai/gpt-oss-120b

# X (Twitter) Scraper Account & Cookies (twscrape)
# Format JSON array berisi kredensial dan cookie sesi Twitter (auth_token & ct0).
# Nilai auth_token dan ct0 dapat diambil dari DevTools browser setelah login ke x.com.
TWITTER_ACCOUNTS_JSON='[{"username":"your_twitter_account","password":"your_password","email":"your_email@domain.com","email_password":"your_email_password","auth_token":"your_auth_token_cookie","ct0":"your_ct0_cookie"}]'

# X (Twitter) Bot Configuration (Opsional - biarkan kosong jika hanya menjalankan Web & API)
X_BOT_USERNAME=
X_BOT_POLL_INTERVAL=60

# Port Pemetaan Docker Compose (Opsional, default: 3000 untuk frontend, 8000 untuk backend)
FRONTEND_PORT=3000
BACKEND_PORT=8000

# CORS Allowed Origins (Opsional untuk instance lokal custom)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,http://localhost:5173,http://localhost